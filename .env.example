# Copia este archivo a .env y ajusta los valores (o define las variables en el sistema).
# SECRET_KEY firma las sesiones. Si no se define, se genera una y se guarda en .secret_key
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
# Contraseña del panel /admin. Si no se define, se genera y se guarda en .admin_password
ADMIN_PASSWORD=cambia-esto
# Base de datos. Por defecto SQLite (heracles.db). Para PostgreSQL:
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/heracles
# Puerto y modo depuracion (solo en desarrollo: FLASK_DEBUG=1)
PORT=5000
FLASK_DEBUG=0
